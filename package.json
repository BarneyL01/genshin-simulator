{
  "name": "genshin-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "kb:validate": "tsx scripts/kb-validate.ts",
    "kb:index": "tsx scripts/kb-index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "kb:fetch-gcsim": "mkdir -p .cache && (test -d .cache/gcsim || git clone --depth 1 https://github.com/genshinsim/gcsim.git .cache/gcsim)",
    "kb:import:character": "tsx scripts/kb-import/import-character.ts",
    "kb:import:weapon": "tsx scripts/kb-import/import-weapon.ts",
    "kb:import:artifact": "tsx scripts/kb-import/import-artifact.ts",
    "kb:inspect": "tsx scripts/kb-import/inspect.ts",
    "sim": "tsx scripts/sim.ts",
    "kb:import:team": "tsx scripts/kb-import/import-team.ts",
    "sim:team": "tsx scripts/sim-team.ts",
    "e2e": "tsx scripts/e2e.ts",
    "compare": "tsx scripts/compare-teams.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "genshin-db": "^5.2.14",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}

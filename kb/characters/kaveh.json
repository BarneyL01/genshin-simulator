  "passives": [
    {
      "id": "kaveh.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "An Architect's Undertaking: When DMG dealt by a Dendro Core (including DMG from Burgeon and Hyperbloom) hits Kaveh, Kaveh will regain HP equal to 300% of his Elemental Mastery. This effect can be triggered once every 0.5s."
    },
    {
      "id": "kaveh.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "A Craftsman's Curious Conceptions: During Painted Dome, after Kaveh's Normal, Charged, or Plunging Attacks hit opponents, his Elemental Mastery will increase by 25. This effect can be triggered once every 0.1s. Max 4 stacks.\nThis effect will be canceled when Painted Dome's effects end."
    },
    {
      "id": "kaveh.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "The Art of Budgeting: When Kaveh crafts Landscape, Building, and Courtyard-type Furnishings, he has a 100% chance to refund a portion of the materials used."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Sublime Salutations: Within 3s after using Artistic Ingenuity, Kaveh's Dendro RES and Incoming Healing Bonus will be increased by 50% and 25% respectively."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Grace of Royal Roads: Kaveh's Normal Attack SPD increases by 15% during Painted Dome."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Profferings of Dur Untash: Increases the Level of Painted Dome by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Feast of Apadana: Dendro Cores created from Bloom and Lunar-Bloom reactions Kaveh triggers will deal 60% more DMG when they burst."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Treasures of Bonkhanak: Increases the Level of Artistic Ingenuity by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Pairidaeza's Dreams: When Kaveh's Normal, Charged, or Plunging Attacks hit opponents during Painted Dome, they will unleash Pairidaeza's Light upon the opponent's position, dealing 61.8% of Kaveh's ATK as AoE Dendro DMG and causing all Dendro Cores within that AoE to burst. This effect can be triggered once every 3s."
    }
  ],

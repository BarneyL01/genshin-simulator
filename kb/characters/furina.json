  "passives": [
    {
      "id": "furina.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Endless Waltz: When the active character in your party receives healing, if the source of the healing is not Furina herself and the healing overflows, then Furina will heal nearby party members for 2% of their Max HP once every 2s for the next 4s."
    },
    {
      "id": "furina.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Unheard Confession: Every 1,000 points of Furina's Max HP can buff the different Arkhe-aligned Salon Solitaire in the following ways:\nWill increase Salon Members' DMG dealt by 0.7%, up to a maximum of 28%.\nWill decrease the Singer of Many Waters' healing interval for nearby active characters by 0.4%, up to a maximum of 16%."
    },
    {
      "id": "furina.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "The Sea Is My Stage: Xenochromatic Fontemer Aberrant ability CD decreased by 30%."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "\"Love Is a Rebellious Bird That None Can Tame\": When using Let the People Rejoice, Furina will gain 150 Fanfare.\nAdditionally, Furina's Fanfare limit is increased by 100."
    },
    {
      "level": 2,
      "effects": [],
      "text": "\"A Woman Adapts Like Duckweed in Water\": While Let the People Rejoice lasts, Furina's Fanfare gain from increases or decreases in nearby characters' HP is increased by 250%. Each point of Fanfare above the limit will increase Furina's Max HP by 0.35%. Her maximum Max HP increase is 140%."
    },
    {
      "level": 3,
      "effects": [],
      "text": "\"My Secret Is Hidden Within Me, No One Will Know My Name\": Increases the Level of Let the People Rejoice by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "\"They Know Not Life, Who Dwelt in the Netherworld Not!\": When the Salon Members from Salon Solitaire hit an opponent, or the Singer of Many Waters restores HP to nearby active characters, Furina will restore 4 Energy. This effect can be triggered once every 5s."
    },
    {
      "level": 5,
      "effects": [],
      "text": "\"His Name I Now Know, It Is...!\": Increases the Level of Salon Solitaire by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "\"Hear Me — Let Us Raise the Chalice of Love!\": When using Salon Solitaire, Furina gains \"Center of Attention\" for 10s.\nThroughout the duration, Furina's Normal Attacks, Charged Attacks, and Plunging Attacks are converted into Hydro DMG which cannot be overridden by any other elemental infusion. DMG is also increased by an amount equivalent to 18% of Furina's max HP.\nThroughout the duration, Furina's Normal Attacks (not including Arkhe: Seats Sacred and Secular Attacks), Charged Attacks, and the impact of Plunging Attacks will cause different effects up to every 0.1s after hitting opponents dep"
    }
  ],

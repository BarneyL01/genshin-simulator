  "passives": [
    {
      "id": "sethos.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Black Kite's Enigma: When Aiming, the charging time is decreased by 0.285s based on each point of Sethos's current Elemental Energy. Charging time can be reduced to a minimum of 0.3s through this method and a maximum of 20 Energy can be tallied. If a Shadowpiercing Shot is fired, consume the tallied amount of Elemental Energy; if it is a Charge Level 1 shot, then consume 50% of the tallied amount of Elemental Energy."
    },
    {
      "id": "sethos.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "The Sand King's Boon: Sethos gains the \"Scorching Sandshade\" effect, increasing the DMG dealt by Shadowpiercing Shots by 700% of Sethos's Elemental Mastery.\nThe Scorching Sandshade effect will be canceled when any of the following conditions are met:\n· 5s after a Shadowpiercing Shot first hits an opponent.\n· After 4 Shadowpiercing Shots strike opponents.\n\nWhen a Shadowpiercing Shot affected by Scorching Sandshade first hits an opponent, Sethos will regain Scorching Sandshade after 15s."
    },
    {
      "id": "sethos.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Thoth's Revelation: Displays the location of nearby resources unique to Sumeru on the mini-map."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Sealed Shrine's Spiritsong: The CRIT Rate of Shadowpiercing Shot is increased by 15%."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Papyrus Scripture of Silent Secrets: When any of the following conditions are met, Sethos gains a 15% Electro DMG Bonus for 10s that may stack twice, with each stack duration counted independently:\n· Consuming Elemental Energy through Aimed Shots. You must first unlock the Ascension Talent \"Black Kite's Enigma\" to trigger this condition.\n· Regaining Elemental Energy by triggering Elemental Reactions using Ancient Rite: The Thundering Sands.\n· Using Secret Rite: Twilight Shadowpiercer."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Ode to the Moonrise Sage: Increases the Level of Normal Attack: Royal Reed Archery by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Beneficent Plumage: When a Shadowpiercing Shot or Dusk Bolt strikes 2 or more opponents, all nearby party members gain 80 Elemental Mastery for 10s."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Record of the Desolate God's Burning Sands: Increases the Level of Secret Rite: Twilight Shadowpiercer by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Pylon of the Sojourning Sun Temple: After Shadowpiercing Shot strikes an opponent, the Elemental Energy consumed by the Ascension Talent \"Black Kite's Enigma\" will be returned. This effect can be triggered up to once every 15s. You must first unlock the Ascension Talent \"Black Kite's Enigma.\""
    }

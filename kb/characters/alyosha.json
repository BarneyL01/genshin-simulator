  "passives": [
    {
      "id": "alyosha.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Awakened by the Baying Hounds: When **Tugarin** attacks, it will also restore HP to nearby active characters at 120% of Alyosha's ATK."
    },
    {
      "id": "alyosha.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Suffer the Winter Wheat Will: Increases the DMG Alyosha deals with his Elemental Skill and Elemental Burst by 0.35% for every 1% of his Energy Recharge. Up to a 70% increase can be obtained in this way."
    },
    {
      "id": "alyosha.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Into the Fray: Alyosha will enter the Radiance: Stellar-Conduct state when inside a **Polestar Field**.\nRadiance: Stellar-Conduct: The Hunter's Precision effect obtained when the **Hunter's Mark** is activated will also increase Stellar-Conduct reaction DMG dealt by the character when on the field by 20%."
    },
    {
      "id": "alyosha.passive4",
      "unlock": "p4",
      "effects": [],
      "text": "Treetop Watch: Displays the location of nearby resources unique to Snezhnaya on the mini-map, and this effect also applies in the Shadow Realm."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Frostvale Thunderclap: Alyosha regenerates 15 Elemental Energy when nearby party members trigger an Electro-related reaction on an opponent. This effect can trigger once every 18s."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Howl From Afar: The duration of the Elemental Burst Hunter's Advance is extended by 6s.\nAdditionally, each time **Tugarin** attacks the opponent, he will also apply the **Hunter's Mark** to a target. This effect does not activate existing Hunter's Marks."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Friendly Call: Increases the Level of the Elemental Skill Thunderbolt Strike by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Harvest the Spoils: When **Tugarin** attacks, he will also restore 60% of Alyosha's ATK as HP to the nearby party member with the lowest HP by percentage."
    },
    {
      "level": 5,
      "effects": [],
      "text": "When the Nightbird Falls Silent: Increases the Level of the Elemental Burst Hunter's Advance by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Standard Reclaimed: The Hunter's Precision effect obtained from activating a **Hunter's Mark** can now stack, max 2 stacks. When the stack count reaches 2, characters affected by Hunter's Precision will also have their Elemental Mastery increased by 100 if they are on the field."
    }
  ],

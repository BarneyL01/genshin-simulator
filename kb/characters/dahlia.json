  "passives": [
    {
      "id": "dahlia.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "The Wind's Gentle Grace: When characters affected by the Favonian Favor effect of the Elemental Burst **Radiant Psalter** trigger Frozen reactions on opponents, they will grant Dahlia 2 Benison stacks. This effect can trigger once every 8s."
    },
    {
      "id": "dahlia.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Prayer of Well-Wrought Joy: When your active party member is affected by the Favonian Favor effect of the Elemental Burst **\"Radiant Psalter,\"** their ATK SPD will increase based on Dahlia's Max HP: Every 1,000 Max HP will cause an increase of 0.5%, up to a maximum of 20%."
    },
    {
      "id": "dahlia.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Pilgrimage Upon Returning Winds: During the day (06:00 – 18:00), your party members gain the Swift Stride effect: Movement SPD increased by 10%.\nDoes not take effect in Domains, Trounce Domains, or the Spiral Abyss. Swift Stride does not stack."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Infallible Procession: Each time Dahlia gains 1 of his Elemental Burst **Radiant Psalter**'s Benison stacks, he will regain 2.5 Elemental Energy."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Revelation of Mercy: After Dahlia consumes his Elemental Burst **Radiant Psalter**'s Benison stacks to summon a Shield of Sacred Favor, the character protected by said Shield will gain 25% increased Shield Strength for 12s."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Windblume Offertory: Increases the Level of **Radiant Psalter** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Collect of the Assembly: The Favonian Favor from Dahlia's Elemental Burst **Radiant Psalter** lasts 3 more seconds."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Let It Be Subtly So: Increases the Level of **Immersive Ordinance** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "You Shall Go Out With Joy: The current active character affected by the Elemental Burst **Radiant Psalter**'s Favonian Favor has their ATK SPD increased by 10%.\nAdditionally, when an active character affected by Favonian Favor falls, immediately:\n· Revive them.\n· Restore their HP to 100%.\nThis effect can trigger once every 15 minutes."
    }
  ],

  "passives": [
    {
      "id": "chongyun.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Steady Breathing: Sword, Claymore, or Polearm-wielding characters within the field created by Spirit Blade: Chonghua's Layered Frost have their Normal ATK SPD increased by 8%."
    },
    {
      "id": "chongyun.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Rimechaser Blade: When the field created by Spirit Blade: Chonghua's Layered Frost disappears, another spirit blade will be summoned to strike nearby opponents, dealing 100% of Chonghua's Layered Frost's Skill DMG as AoE Cryo DMG. Opponents hit by this blade will have their Cryo RES decreased by 10% for 8s."
    },
    {
      "id": "chongyun.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Gallant Journey: When dispatched on an expedition in Liyue, time consumed is reduced by 25%."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Ice Unleashed: The last attack of Chongyun's Normal Attack combo releases 3 ice blades. Each blade deals 50% of Chongyun's ATK as Cryo DMG to all opponents in its path."
    },
    {
      "level": 2,
      "effects": [],

  "passives": [
    {
      "id": "alhaitham.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Four-Causal Correction: When Alhaitham's Charged or Plunging Attacks hit opponents, they will generate 1 Chisel-Light Mirror. This effect can be triggered once every 12s."
    },
    {
      "id": "alhaitham.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Mysteries Laid Bare: Each point of Alhaitham's Elemental Mastery will increase the DMG dealt by Projection Attacks and Particular Field: Fetters of Phenomena by 0.1%.\nThe DMG of both aforementioned abilities can be increased by a maximum of 100% this way."
    },
    {
      "id": "alhaitham.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Law of Reductive Overdetermination: When Alhaitham crafts Weapon Ascension Materials, he has a 10% chance to receive double the product."
    }
  ],

  "passives": [
    {
      "id": "mona.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "\"Come 'n' Get Me, Hag!\": After she has used Illusory Torrent for 2s, if there are any opponents nearby, Mona will automatically create a Phantom.\nA Phantom created in this manner lasts for 2s, and its explosion DMG is equal to 50% of Mirror Reflection of Doom."
    },
    {
      "id": "mona.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Waterborne Destiny: Increases Mona's Hydro DMG Bonus by a degree equivalent to 20% of her Energy Recharge rate."
    },
    {
      "id": "mona.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Principium of Astrology: When Mona crafts Weapon Ascension Materials, she has a 25% chance to refund a portion of the crafting materials used."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Prophecy of Submersion: When any of your own party members hits an opponent affected by an Omen, the effects of Hydro-related Elemental Reactions are enhanced for 8s:\n· Electro-Charged DMG increases by 15%, Lunar-Charged DMG increases by 15%, Vaporize DMG increases by 15%, Hydro Swirl DMG increases by 15%, Lunar-Crystallize DMG increases by 15%.\n· Frozen duration is extended by 15%."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Lunar Chain: When a Normal Attack hits, there is a 20% chance that it will be automatically followed by a Charged Attack.\nThis effect can only occur once every 5s."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Restless Revolution: Increases the Level of Stellaris Phantasm by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Prophecy of Oblivion: When any party member attacks an opponent affected by an Omen, their CRIT Rate is increased by 15%."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Mockery of Fortuna: Increases the Level of Mirror Reflection of Doom by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Rhetorics of Calamitas: Upon entering Illusory Torrent, Mona gains a 60% increase to the DMG of her next Charged Attack per second of movement.\nA maximum DMG Bonus of 180% can be achieved in this manner. The effect lasts for no more than 8s."
    }
  ],

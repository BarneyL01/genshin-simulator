  "passives": [
    {
      "id": "aino.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Modular Efficiency Protocol: Aino will be granted the corresponding buff effects based on the party's Moonsign.\n\nMoonsign: Ascendant Gleam: Her Elemental Burst **Precision Hydronic Cooler** is enhanced: The Cool Your Jets Ducky will fire water balls more frequently, and the water balls will deal AoE Hydro DMG over a larger area of effect."
    },
    {
      "id": "aino.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Structured Power Booster: Aino's Elemental Burst DMG is increased by 50% of her Elemental Mastery."
    },
    {
      "id": "aino.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Moonsign Benediction: Force Limit Analysis: When Aino is in the party, the party's Moonsign will increase by 1 level."
    },
    {
      "id": "aino.passive4",
      "unlock": "p4",
      "effects": [],
      "text": "Miniaturized Detection Sensor: Displays the location of nearby resources unique to Nod-Krai on the mini-map.\nAdditionally, Aino appears to be able to alter the Cool Your Jets Ducky's appearance in some way..."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "The Theory of Ash—Field Equilibrium: After Aino uses her Elemental Skill **Musecatcher** or her Elemental Burst **Precision Hydronic Cooler**, her Elemental Mastery will be increased by 80. The Elemental Mastery of other nearby active party members will be increased by 80 for 15s.\n\nThe Elemental Mastery-increasing effects of this Constellation do not stack."
    },
    {
      "level": 2,
      "effects": [],
      "text": "The Principle of Transference in Gear Differentials: If Aino is off-field while the Focused Hydronic Cooling Zone of her Elemental Burst **Precision Hydronic Cooler** is active, when your active party member hits a nearby opponent with an attack, the Cool Your Jets Ducky will fire an additional water ball at that opponent, dealing AoE Hydro DMG equal to 25% of Aino's ATK and 100% of her Elemental Mastery. This DMG is considered Elemental Burst DMG. This effect can be triggered once every 5s."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Cake and the Art of Mechanism Repair: Increases the Level of **Precision Hydronic Cooler** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Butter and Cats and the Law of Energy Supply: When the Elemental Skill **Musecatcher** hits an opponent, it will restore 10 Elemental Energy for Aino. Energy can be restored to her in this manner once every 10s."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Perpetual Turbine of Metal and Light: Increases the Level of **Musecatcher** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "The Burden of Creative Genius: For the next 15s after using the Elemental Burst **Precision Hydronic Cooler**, DMG from nearby active characters' Electro-Charged, Bloom, Lunar-Charged, Lunar-Bloom, and Lunar-Crystallize reactions is increased by 15%.\nMoonsign: Ascendant Gleam: DMG from the aforementioned reactions will be further increased by 20%."
    }
  ],

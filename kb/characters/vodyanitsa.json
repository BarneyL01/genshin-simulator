  "passives": [
    {
      "id": "vodyanitsa.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "The Last Djeguako Songstress: When the Elemental Skill Rechitativ: Sonorous Dawn is used, any Stellar Vortex on the field will turn into a Wandering Vortex instead. While the **Song of Ages Past** effect is active, nearby party members' Stellar Swirl reactions will generate Wandering Vortex instead.\nGenerating or detonating a Wandering Vortex will also reduce nearby opponents' Anemo RES by 35% for 6s. \nAdditionally, nearby party members who enter the Radiance: Stellar Swirl state while Song of Ages Past is in effect will have the Radiance: Stellar Swirl state extended by 4s."
    },
    {
      "id": "vodyanitsa.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Dirge of the Fandyr: When the Elemental Skill Rechitativ: Sonorous Dawn is used, Vodyanitsa will also gain 25 stacks of **Lead Vocal** as well as 10 stacks of **Chorus**.\nThe two effects above last 30s each, and the stack count is refreshed when the Elemental Skill is used."
    },
    {
      "id": "vodyanitsa.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Echoes Over the Frozen Lake: Holding the Elemental Skill outside of combat will cause Vodyanitsa to embody her true Water Imp form and swim for up to 10s at the cost of Stamina. Naturally, as a Water Imp, she can also move across the water's surface. Vodyanitsa will exit her Water Imp form when the Elemental Skill is used again, when the duration ends, or when all Stamina is depleted.\nAdditionally, while Vodyanitsa can swim faster, her Stamina consumption rate is also increased."
    },
    {
      "id": "vodyanitsa.passive4",
      "unlock": "p4",
      "effects": [],
      "text": "Heartless Siren Song: As the Prima Donna of the Korolevskiy Troupe, Vodyanitsa sings in person in place of playing an instrument."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Waters in Full Splendor: Each time Vodyanitsa triggers the healing effect of **Song of Ages Past**, it also increases the ATK of all nearby party members by 0.8% of her Max HP for 5s."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Echoes That Pierce the Snow: When the Horn of Spring's Call from the Elemental Skill Rechitativ: Sonorous Dawn attacks the opponent, Vodyanitsa gains the \"Two Voices in Black and White\" effect which increases the CRIT DMG from Hydro DMG and Cryo DMG dealt by the currently active party member by 50% for 5s.\nIf there is a Wandering Vortex present on the field or in the 5s after a Wandering Vortex explodes, the effect changes to: increases the CRIT DMG from Stellar Swirl reaction DMG caused by the currently active party member by 60% for 5s.\nAdditionally, the Elemental Skill Rechitativ: Sonorous "
    },
    {
      "level": 3,
      "effects": [],
      "text": "Song Lingering on a Spring Morning: Increases the Level of the Elemental Skill **Rechitativ: Sonorous Dawn** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Melancholic Voice Upon the Gentle Waters: When Vodyanitsa triggers the healing effect of **Song of Ages Past**, an additional effect will be triggered based on the healed character's HP.\n· If the character's HP is below 40%: The healing is increased by 50%; and\n· If the character's HP is 40% or above: Vodyanitsa's Max HP is increased by 20% for 6s. Max 3 stacks, and each stack's duration is counted independently."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Together, Down Into the Deep: Increases the Level of the Elemental Burst **Koda: Sink With Thee** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Neverending Song of Revelry: The Constellation Echoes That Pierce the Snow is enhanced: \"Two Voices in Black and White\" now applies to all nearby party members.\nAdditionally, while the **Song of Ages Past** effect is active, Stellar Swirl reaction DMG dealt by nearby party members is **elevated** by 25% while Hydro DMG and Cryo DMG dealt are increased by 60%."
    }
  ],

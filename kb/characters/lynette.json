  "passives": [
    {
      "id": "lynette.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Sophisticated Synergy: Within 10s after using Magic Trick: Astonishing Shift, when there are 1/2/3/4 Elemental Types in the party, all party members' ATK will be increased by 8%/12%/16%/20% respectively."
    },
    {
      "id": "lynette.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Props Positively Prepped: After the Bogglecat Box summoned by Magic Trick: Astonishing Shift performs Elemental Conversion, Lynette's Elemental Burst will deal 15% more DMG. This effect will persist until the Bogglecat Box's duration ends."
    },
    {
      "id": "lynette.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Loci-Based Mnemonics: Shows the location of nearby Recovery Orbs on the minimap. The Aquatic Stamina and HP gained from touching Orbs will be increased by 25%."
    }
  ],

  "passives": [
    {
      "id": "illuga.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Torchforger's Covenant: After unleashing Elemental Skill **Dawnbearing Songbird** or Elemental Burst **Shadowless Reflection**, other nearby party members will gain the Lightkeeper's Oath effect for 20s: For Geo DMG dealt to opponents, CRIT Rate increases by 5% and CRIT DMG increases by 10%.\n\nMoonsign: Ascendant Gleam \nParty members affected by the Lightkeeper's Oath effect have their Elemental Mastery increased by 50."
    },
    {
      "id": "illuga.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Demonhunter's Dusk: **Nightingale's Song**'s effects are enhanced: When there are 1/2/3 Hydro or Geo characters in the party, Nightingale's Song will further increase DMG. Increase in DMG is equal to 7%/14%/24% of Illuga's Elemental Mastery. If this aforementioned DMG is inflicted by a Lunar-Crystallize reaction, increase in DMG is equal to 48%/96%/160% of Illuga's Elemental Mastery."
    },
    {
      "id": "illuga.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Moonsign Benediction: Unwithering in Winter: When Illuga is in the party, the party's Moonsign will increase by 1 level."
    },
    {
      "id": "illuga.passive4",
      "unlock": "p4",
      "effects": [],
      "text": "Night Warden's Stride: At night (18:00 – 06:00), your party members gain the Swift Stride effect: Movement SPD increased by 10%.\nDoes not take effect in Domains, Trounce Domains, or Spiral Abyss. Swift Stride does not stack.\nAdditionally, Illuga appears to be able to decipher the whispers of the Wild Hunt..."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Vigilant Sentinel: After Illuga triggers a Geo-related Reaction on the field, he will regain 12 Elemental Energy. This effect can be triggered at most once every 15s."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Elk With Fanged Antlers: When Elemental Burst **Shadowless Reflection**'s Haunted Night's Oriole-Song effect is active, for every 7 stacks of **Nightingale's Song** consumed, Illuga will summon Aedon, dealing a single instance of Geo DMG to 1 nearby opponent. The DMG dealt is based on 400% of Illuga's Elemental Mastery and 200% of his DEF. This DMG is considered Elemental Burst DMG."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Earthshaking Maw: Increases the Level of Elemental Burst **Shadowless Reflection** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Solarhunting Wolf: When Elemental Burst **Shadowless Reflection**'s Haunted Night's Oriole-Song effect is active, nearby active party members will have their DEF increased by 200."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Hurricane Steed: Increases the Level of Elemental Skill **Dawnbearing Songbird** by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Nightmare Orioles: Enhances the Lightkeeper's Oath effect of the Ascension Talent **Torchforger's Covenant**: For Geo DMG dealt to opponents, CRIT Rate is increased by 10%, CRIT DMG is increased by 30%.\n\nMoonsign: Ascendant Gleam:\nWhen characters are affected by Lightkeeper's Oath, Elemental Mastery is increased by 80.\nYou must first unlock the Ascension Talent \"Torchforger's Covenant.\""
    }
  ],

  "passives": [
    {
      "id": "xiao.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Conqueror of Evil: Tamer of Demons: While under the effects of Bane of All Evil, all DMG dealt by Xiao increases by 5%. DMG increases by a further 5% for every 3s the ability persists.\nThe maximum DMG Bonus is 25%."
    },
    {
      "id": "xiao.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Dissolution Eon: Heaven Fall: Using Lemniscatic Wind Cycling increases the DMG of subsequent uses of Lemniscatic Wind Cycling by 15%.\nThis effect lasts for 7s, and has a maximum of 3 stacks. Gaining a new stack refreshes the effect's duration."
    },
    {
      "id": "xiao.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Transcension: Gravity Defier: Decreases climbing Stamina consumption for your own party members by 20%.\nNot stackable with Passive Talents that provide the exact same effects."
    }
  ],

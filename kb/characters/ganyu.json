      "effects": [],
      "text": "Undivided Heart: After firing a Frostflake Arrow, the CRIT Rate of subsequent Frostflake Arrows and their resulting bloom effects is increased by 20% for 5s."
    },
    {
      "id": "ganyu.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Harmony Between Heaven and Earth: Celestial Shower grants a 20% Cryo DMG Bonus to active party members in the AoE."
    },
    {
      "id": "ganyu.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Preserved for the Hunt: Refunds 15% of the ore used when crafting Bow-type weapons."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Dew-Drinker: Charge Level 2 Frostflake Arrows or Frostflake Arrow Blooms decrease opponents' Cryo RES by 15% for 6s upon hit.\nA hit also regenerates 2 Energy for Ganyu. This effect can only occur once per Charge Level 2 Frostflake Arrow, regardless if Frostflake Arrow itself or its Bloom hits the target."
    },
    {
      "level": 2,
      "effects": [],
      "text": "The Auspicious: Trail of the Qilin gains 1 additional charge."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Cloud-Strider: Increases the Level of Celestial Shower by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Westward Sojourn: Opponents standing within the AoE of Celestial Shower take increased DMG. This effect strengthens over time.\nIncreased DMG taken begins at 5% and increases by 5% every 3s, up to a maximum of 25%.\nThe effect lingers for 3s after the opponent leaves the AoE."
    },
    {
      "level": 5,
      "effects": [],
      "text": "The Merciful: Increases the Level of Trail of the Qilin by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "The Clement: Using Trail of the Qilin causes the next Frostflake Arrow shot within 30s to not require charging."
    }

  "passives": [
    {
      "id": "kuki-shinobu.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Breaking Free: When Shinobu's HP is not higher than 50%, her Healing Bonus is increased by 15%."
    },
    {
      "id": "kuki-shinobu.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Heart's Repose: Sanctifying Ring's abilities will be boosted based on Shinobu's Elemental Mastery:\n·Healing amount will be increased by 75% of Elemental Mastery.\n·DMG dealt is increased by 25% of Elemental Mastery."
    },
    {
      "id": "kuki-shinobu.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Protracted Prayers: Gains 25% more rewards when dispatched on an Inazuma Expedition for 20 hours."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "To Cloister Compassion: Gyoei Narukami Kariyama Rite's AoE is increased by 50%."
    },
    {
      "level": 2,
      "effects": [],
      "text": "To Forsake Fortune: Grass Ring of Sanctification's duration is increased by 3s."
    },
    {
      "level": 3,
      "effects": [],
      "text": "To Sequester Sorrow: Increases the Level of Sanctifying Ring by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "To Sever Sealing: When the Normal, Charged, or Plunging Attacks of the character affected by Shinobu's Grass Ring of Sanctification hit opponents, a Thundergrass Mark will land on the opponent's position and deal AoE Electro DMG based on 9.7% of Shinobu's Max HP.\nThis effect can occur once every 5s."
    },
    {
      "level": 5,
      "effects": [],
      "text": "To Cease Courtesies: Increases the Level of Gyoei Narukami Kariyama Rite by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "To Ward Weakness: When Kuki Shinobu takes lethal DMG, this instance of DMG will not take her down. This effect will automatically trigger when her HP reaches 1 and will trigger once every 60s.\nWhen Shinobu's HP drops below 25%, she will gain 150 Elemental Mastery for 15s. This effect will trigger once every 60s."
    }

  "passives": [
    {
      "id": "shikanoin-heizou.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Paradoxical Practice: When Shikanoin Heizou activates a Swirl or Stellar Swirl reaction while on the field, he will gain 1 Declension stack for Heartstopper Strike. This effect can be triggered once every 0.1s."
    },
    {
      "id": "shikanoin-heizou.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Penetrative Reasoning: After Shikanoin Heizou's Heartstopper Strike hits an opponent, increases all party members' (excluding Shikanoin Heizou) Elemental Mastery by 80 for 10s."
    },
    {
      "id": "shikanoin-heizou.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Pre-Existing Guilt: Decreases sprinting Stamina consumption for your own party members by 20%.\nNot stackable with Passive Talents that provide the exact same effects."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Named Juvenile Casebook: For 5s after Shikanoin Heizou takes the field, his Normal Attack SPD is increased by 15%. He also gains 1 Declension stack for Heartstopper Strike. This effect can be triggered once every 10s."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Investigative Collection: The pull effect of the Arresting Windtunnel created by Windmuster Kick is enhanced, and its duration is increased to 1s."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Esoteric Puzzle Book: Increases the Level of Heartstopper Strike by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Tome of Lies: The first Windmuster Iris explosion in each Windmuster Kick will regenerate 9 Elemental Energy for Shikanoin Heizou. Every subsequent explosion in that Windmuster Kick will each regenerate an additional 1.5 Energy for Heizou.\nOne Windmuster Kick can regenerate a total of 13.5 Energy for Heizou in this manner."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Secret Archive: Increases the Level of Windmuster Kick by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Curious Casefiles: Each Declension stack will increase the CRIT Rate of the Heartstopper Strike unleashed by 4%. When Heizou possesses Conviction, this Heartstopper Strike's CRIT DMG is increased by 32%."
    }

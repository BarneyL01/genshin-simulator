  "passives": [
    {
      "id": "gorou.passive1",
      "unlock": "p1",
      "effects": [],
      "text": "Heedless of the Wind and Weather: After using Juuga: Forward Unto Victory, all nearby party members' DEF is increased by 25% for 12s."
    },
    {
      "id": "gorou.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "A Favor Repaid: Gorou receives the following DMG Bonuses to his attacks based on his DEF:\n· Inuzaka All-Round Defense: Skill DMG increased by 156% of DEF\n· Juuga: Forward Unto Victory: Skill DMG and Crystal Collapse DMG increased by 15.6% of DEF"
    },
    {
      "id": "gorou.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Seeker of Shinies: Displays the location of nearby resources unique to Inazuma on the mini-map."
    }
  ],
  "constellations": [
    {
      "level": 1,
      "effects": [],
      "text": "Rushing Hound: Swift as the Wind: When characters (other than Gorou) within the AoE of Gorou's General's War Banner or General's Glory deal Geo DMG to opponents, the CD of Gorou's Inuzaka All-Round Defense is decreased by 2s.\nThis effect can occur once every 10s."
    },
    {
      "level": 2,
      "effects": [],
      "text": "Sitting Hound: Steady as a Clock: While General's Glory is in effect, its duration is extended by 1s when a nearby active character obtains an Elemental Shard from a Crystallize reaction, or triggers a Lunar-Crystallize reaction. \nThis effect can occur once every 0.1s. Max extension is 3s."
    },
    {
      "level": 3,
      "effects": [],
      "text": "Mauling Hound: Fierce as Fire: Increases the Level of Inuzaka All-Round Defense by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 4,
      "effects": [],
      "text": "Lapping Hound: Warm as Water: When General's Glory is in the \"Impregnable\" or \"Crunch\" states, it will also heal active characters within its AoE by 50% of Gorou's own DEF every 1.5s."
    },
    {
      "level": 5,
      "effects": [],
      "text": "Striking Hound: Thunderous Force: Increases the Level of Juuga: Forward Unto Victory by 3.\nMaximum upgrade level is 15."
    },
    {
      "level": 6,
      "effects": [],
      "text": "Valiant Hound: Mountainous Fealty: For 12s after using Inuzaka All-Round Defense or Juuga: Forward Unto Victory, increases the CRIT DMG of all nearby party members' Geo DMG based on the buff level of the skill's field at the time of use:\n· \"Standing Firm\": +10%\n· \"Impregnable\": +20%\n· \"Crunch\": +40%\n\nThis effect cannot stack and will take reference from the last instance of the effect that is triggered."
    }
  ],

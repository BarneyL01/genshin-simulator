      "effects": [],
      "text": "Cold-Blooded Strike: Every hit with Frostgnaw regenerates HP for Kaeya equal to 15% of his ATK."
    },
    {
      "id": "kaeya.passive2",
      "unlock": "p2",
      "effects": [],
      "text": "Glacial Heart: Opponents Frozen by Frostgnaw will drop additional Elemental Particles.\nFrostgnaw may only produce a maximum of 2 additional Elemental Particles per use."
    },
    {
      "id": "kaeya.passive3",
      "unlock": "p3",
      "effects": [],
      "text": "Hidden Strength: Decreases sprinting Stamina consumption for your own party members by 20%.\nNot stackable with Passive Talents that provide the exact same effects."
    }
  ],
